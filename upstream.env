# Upstream versions this image is built from. Renovate updates these lines;
# CI rebuilds, runs the package-drift check and the smoke test before merge.
# Format: KEY=value, values limited to [A-Za-z0-9._-] (scripts/upstream-env.sh
# refuses anything else before a workflow sources this file).
# renovate: datasource=github-releases depName=pi-hole/docker-pi-hole versioning=loose
PIHOLE_DOCKER_TAG=2026.10.1
# renovate: datasource=github-releases depName=pi-hole/FTL versioning=loose
FTL_VERSION=v6.8
# renovate: datasource=github-releases depName=pi-hole/pi-hole versioning=loose
CORE_VERSION=v6.5
# renovate: datasource=github-releases depName=pi-hole/web versioning=loose
WEB_VERSION=v6.6.1
# Trivy 0.69.4 was malicious (March 2026), so Trivy is not automerged: Renovate
# proposes the version with a 7-day cooldown, and the two tarball hashes below
# must be updated by the reviewer (scripts/install-trivy.sh checks the download
# against them, not against the checksum file next to it). Before updating,
# compare the hashes with a second channel, e.g. the binary inside
# ghcr.io/aquasecurity/trivy:<version> (identical for 0.69.3 on both arches).
# renovate: datasource=github-releases depName=aquasecurity/trivy
TRIVY_VERSION=0.69.3
TRIVY_SHA256_LINUX_64BIT=1816b632dfe529869c740c0913e36bd1629cb7688bd5634f4a858c1d57c88b75
TRIVY_SHA256_LINUX_ARM64=7e3924a974e912e57b4a99f65ece7931f8079584dae12eb7845024f97087bdfd
# ORAS copies the signed image and everything attached to it (signatures,
# attestations, provenance) to Docker Hub. Same policy as Trivy: not
# automerged, and the reviewer updates the two hashes. ORAS releases also
# carry .asc signatures; its GHCR image is a separate build, so it is not a
# usable second channel for these hashes.
# renovate: datasource=github-releases depName=oras-project/oras
ORAS_VERSION=1.3.6
ORAS_SHA256_LINUX_AMD64=66fb0ad7206f3f6fa77ed5b552049d364ccf4b50b1684554f731f76302b52ca0
ORAS_SHA256_LINUX_ARM64=b84269e78dfc2d5329a4aab373da3200de95e6c138338cf6c66c10c0a3f248c1
